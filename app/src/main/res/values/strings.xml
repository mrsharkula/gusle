    <string name="allow">Allow</string>
    <string name="access_off_title">Music access is off</string>
    <string name="access_off_text">Without it Gusle can\'t see your songs. Turn it on in the watch\'s settings.</string>
    <string name="open_settings">Open settings</string>
    <string name="no_songs_title">No songs yet</string>
    <string name="no_songs_text">Send music to your watch with Wear Files.</string>
    <string name="rescan">Rescan</string>
