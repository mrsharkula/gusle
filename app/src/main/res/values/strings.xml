<resources>
    <string name="app_name">Gusle</string>
    <string name="home_title">Gusle</string>
    <string name="all_songs">All songs</string>
    <string name="favorites">Favorites</string>
    <!-- The heart on Now playing and the tile, and a swiped row's button, as screen readers say them. -->
    <string name="add_to_favorites">Add to favorites</string>
    <string name="remove_from_favorites">Remove from favorites</string>
    <!-- The small heart on a favorite song's row, as screen readers say it. -->
    <string name="favorite">Favorite</string>
    <!-- What holding a song does, as screen readers offer it: "Double-tap and hold to open song options". -->
    <string name="open_song_options">Open song options</string>
    <!-- The button on a song's actions that deletes it from the watch; screen readers say
         delete_from_watch instead. -->
    <string name="delete">Delete</string>
    <string name="delete_from_watch">Delete from the watch</string>
    <!-- Gusle's question before Android's own, e.g. "Delete “Bismarck” from the watch?". -->
    <string name="delete_song_question">Delete “%1$s” from the watch?</string>
    <!-- Said to screen readers once a song or a playlist is deleted and its actions have closed. -->
    <string name="deleted">Deleted</string>
    <string name="couldnt_delete">Couldn\'t delete</string>
    <string name="no_favorites_title">No favorites yet</string>
    <string name="no_favorites_text">Tap the heart on Now playing, or swipe a song left.</string>
    <string name="playlists">Playlists</string>
    <string name="new_playlist">New playlist</string>
    <!-- The title of Wear's own text input, where a playlist's name is typed or said. -->
    <string name="playlist_name">Playlist name</string>
    <string name="no_playlists_title">No playlists yet</string>
    <!-- Under "No playlists yet", and in a playlist with no songs. -->
    <string name="add_to_playlist_hint">Hold a song and choose Add to playlist.</string>
    <!-- The button on a song's actions, and the title of the list of playlists it opens. -->
    <string name="add_to_playlist">Add to playlist</string>
    <!-- On a song's actions, when it was held inside a playlist: takes that one entry out. -->
    <string name="remove_from_playlist">Remove from this playlist</string>
    <!-- Shown for a moment once a song is added to a playlist, e.g. "Added to “Road trip”". -->
    <string name="added_to_playlist">Added to “%1$s”</string>
    <!-- Said to screen readers once a song is taken out of a playlist and its actions have closed. -->
    <string name="removed_from_playlist">Removed</string>
    <!-- What holding a playlist does, as screen readers offer it: "Double-tap and hold to open playlist options". -->
    <string name="open_playlist_options">Open playlist options</string>
    <!-- The button on a playlist's actions that opens Wear's text input with its name. -->
    <string name="rename">Rename</string>
    <!-- Gusle's question before a playlist is deleted, e.g. "Delete “Road trip”?", with
         delete_playlist_text under it. -->
    <string name="delete_playlist_question">Delete “%1$s”?</string>
    <string name="delete_playlist_text">Its songs stay on the watch.</string>
    <string name="albums">Albums</string>
    <string name="artists">Artists</string>
    <!-- Stands for the artist of the songs without one: in Artists, and as their songs' title. -->
    <string name="unknown_artist">Unknown artist</string>
    <!-- Stands for the album of the songs without one: in Albums, and as their songs' title. -->
    <string name="unknown_album">Unknown album</string>
    <!-- Under an album whose songs are by different artists. -->
    <string name="various_artists">Various artists</string>
    <string name="settings">Settings</string>
    <string name="permission_title">Play your music</string>
