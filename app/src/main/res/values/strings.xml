    <string name="shuffle_on">Shuffle on</string>
    <string name="shuffle_off">Shuffle off</string>
    <string name="queue">Queue</string>
    <string name="cant_play">Can\'t play</string>
    <string name="end_of_list">End of list</string>
    <string name="playing">Playing</string>
    <string name="paused">Paused</string>
    <string name="cant_play_song">Can\'t play this song</string>
    <string name="cant_play_titled">Can\'t play “%1$s”</string>
    <string name="cant_play_now">Can\'t play right now</string>
    <!-- The time under the title on Now playing, a button that opens the seek screen, as screen
         readers say it: e.g. "1 minute 23 seconds, seek". -->
    <string name="elapsed_seek">%1$s, seek</string>
    <!-- The small time at the bottom of the seek screen, when it shows how much of the song is
         left: e.g. "−1:34" (a minus sign). A tap on it switches it to the song's length ("4:47")
         and back. -->
    <string name="time_left">−%1$s</string>
    <!-- The same two, as screen readers say them: e.g. "4 minutes 47 seconds long", "1 minute 34
         seconds left". -->
    <string name="length_long">%1$s long</string>
    <string name="time_left_words">%1$s left</string>
    <!-- What a tap on that time does, as screen readers say it. -->
    <string name="show_time_left">Show time left</string>
    <string name="show_length">Show length</string>
    <!-- Which of the two that time shows, as its state for screen readers, so a tap's switch is
         announced. -->
    <string name="length_state">Length</string>
    <string name="time_left_state">Time left</string>
    <!-- The big time on the seek screen, as screen readers say it: e.g. "1 minute 23 seconds of 3
         minutes 45 seconds". -->
    <string name="position_of_length">%1$s of %2$s</string>
    <!-- A hint at the bottom of the seek screen, for a few seconds after it opens. -->
    <string name="turn_the_crown">Turn the crown</string>
    <!-- On the tile, when there's no song to show. -->
    <string name="tile_nothing_playing_text">Pick a song in Gusle, or shuffle them all.</string>
    <!-- On the tile, when there's no song to show nor any to shuffle, e.g. before Gusle may read
         the music. -->
    <string name="tile_open_gusle_text">Open Gusle to pick a song.</string>
    <string name="open_gusle">Open Gusle</string>
    <!-- The always-on display, under the bar of a paused song: e.g. "Paused at 1:23". -->
    <string name="paused_at">Paused at %1$s</string>
    <string name="stop_playing">Stop playing</string>
    <string name="rescan_music">Rescan music</string>
    <string name="rescanning">Scanning…</string>
    <string name="theme">Theme</string>
    <!-- Under the default theme, jump step and crown step. -->
    <string name="default_choice">Default</string>
    <!-- Under the list of themes: while such a song plays, the screens are in its colors, so a
         theme chosen then doesn't show yet. -->
    <string name="theme_note">Songs with a cover keep their cover’s colors.</string>
    <string name="theme_walnut">Walnut</string>
    <string name="theme_olive">Olive</string>
    <string name="theme_basil">Basil</string>
    <string name="theme_adriatic">Adriatic</string>
    <string name="theme_plum">Plum</string>
    <string name="theme_peony">Peony</string>
    <!-- Settings → Jump by: how far the − and + buttons jump; the row's second line is the step,
         e.g. "10 seconds" (the seconds plural). -->
    <string name="jump_by">Jump by</string>
    <!-- Under the list of steps. -->
    <string name="jump_by_note">For the − and + buttons on the seek screen and the tile.</string>
    <!-- Settings → Crown step: how far a step of the crown moves the song on the seek screen. -->
    <string name="crown_step">Crown step</string>
    <!-- Under the list of steps. -->
    <string name="crown_step_note">For turning the crown on the seek screen. Quick turns move two and four times as far.</string>
    <string name="about">About</string>
    <string name="version">Version %1$s</string>
    <string name="about_text">Plays the music stored on your watch.</string>
    <plurals name="song_count">
        <item quantity="one">%d song</item>
        <item quantity="other">%d songs</item>
    </plurals>
    <plurals name="artist_count">
        <item quantity="one">%d artist</item>
        <item quantity="other">%d artists</item>
    </plurals>
    <plurals name="album_count">
        <item quantity="one">%d album</item>
        <item quantity="other">%d albums</item>
    </plurals>
    <plurals name="playlist_count">
        <item quantity="one">%d playlist</item>
        <item quantity="other">%d playlists</item>
    </plurals>
    <!-- Under a playlist in the list Add to playlist opens, when the song is in it already: its song
         count (song_count), and how often the song is there, e.g. "5 songs · in it 2 times". -->
    <plurals name="song_count_in_it">
        <item quantity="one">%2$s · in it already</item>
        <item quantity="other">%2$s · in it %1$d times</item>
    </plurals>
    <!-- Lengths in words, for screen readers: e.g. "1 hour 2 minutes 5 seconds". -->
    <plurals name="hours">
        <item quantity="one">%d hour</item>
        <item quantity="other">%d hours</item>
    </plurals>
    <plurals name="minutes">
        <item quantity="one">%d minute</item>
        <item quantity="other">%d minutes</item>
    </plurals>
    <plurals name="seconds">
        <item quantity="one">%d second</item>
        <item quantity="other">%d seconds</item>
    </plurals>
    <!-- The − and + buttons on the seek screen and the tile, as screen readers say them, with the
