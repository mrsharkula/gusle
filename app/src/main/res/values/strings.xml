    <plurals name="back_seconds">
        <item quantity="one">Back %d second</item>
        <item quantity="other">Back %d seconds</item>
    </plurals>
    <plurals name="forward_seconds">
        <item quantity="one">Forward %d second</item>
        <item quantity="other">Forward %d seconds</item>
    </plurals>
    <!-- The always-on display, under the bar of a playing song: e.g. "2 min left". -->
    <plurals name="minutes_left">
        <item quantity="one">%d min left</item>
        <item quantity="other">%d min left</item>
    </plurals>
    <plurals name="songs_found">
        <item quantity="one">%d song found</item>
        <item quantity="other">%d songs found</item>
    </plurals>
</resources>
