<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Playing in the background. Its media notification needs no POST_NOTIFICATIONS: media
         sessions are exempt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".GusleApp"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher_walnut"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gusle">

        <!-- Lets `dumpsys gfxinfo` and profilers measure release builds. -->
        <profileable android:shell="true" />

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Single-top: Gusle is one activity with its own navigation, so launching it again while
             it's open (the launcher, the media controls, waking to Gusle after the watch's own
             always-on face covered it, e.g. a palm over a OnePlus watch) reaches the one there
             instead of stacking a second one on top. The launcher reaches it through the aliases
             below; the tile launches it itself, the media controls through .OpenNowPlaying. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="" />

        <!-- The launcher icon: one alias per theme, each with the icon in that theme's colors, and
             exactly one enabled at a time (ui/theme/LauncherIcon.kt switches them): the default's,
             or the chosen theme's while the icon follows the theme (Settings → Theme). The names
             must stay forever: an alias that vanished while enabled would take Gusle out of the
             app list. AppThemeTest checks them against AppTheme. -->
        <activity-alias
            android:name=".LauncherWalnut"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_walnut"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherOlive"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_olive"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBasil"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_basil"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherAdriatic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_adriatic"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPlum"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_plum"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPeony"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_peony"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Opens MainActivity on Now playing; the media controls' intent goes here. Not exported,
             so other apps can't ask for it. The tile can't launch it either: it asks MainActivity
             itself, with a key only Gusle knows (OpenNowPlayingExtra). -->
        <activity-alias
            android:name=".OpenNowPlaying"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- Plays the songs, also in the background; the watch's media controls connect to it. -->
        <!-- Exported without a permission on purpose: the session's onConnect only lets in
             Gusle and controllers the system trusts. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- The tile: what's playing, with its buttons, one swipe from the watch face. Only the
             system's tile host may bind it. The preview is what the tile picker shows. -->
        <service
            android:name=".tile.NowPlayingTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_walnut"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <!-- One preview: Gusle is made for round watches (DESIGN.md). -->
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview"
                tools:ignore="SquareAndRoundTilePreviews" />
        </service>
    </application>

</manifest>
